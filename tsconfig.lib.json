{
  "compilerOptions": {
    "target": "ESNext",
    "outDir": "dist",
    "rootDir": "./src/lib",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "types": []
  },
  "include": ["src/lib"],
  // Tests sit next to the code they cover, so they have to be kept out of the published types: they
  // are not part of the surface, and they reach for node builtins this config deliberately has no
  // types for.
  "exclude": [
    "node_modules", "build", "dist",
    "src/lib/**/*.test.ts", "src/lib/**/*.test.tsx", "src/lib/**/*.fixture.ts"
  ]
}
